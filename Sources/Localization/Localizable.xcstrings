{
  "sourceLanguage" : "zh-Hans",
  "strings" : {
    "一次性检查所有历史训练，把缺失的独立距离数据补全。" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Check all historical workouts at once and backfill any missing standalone distance data."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一次性检查所有历史训练，把缺失的独立距离数据补全。"
          }
        }
      }
    },
    "健康数据授权失败" : {
