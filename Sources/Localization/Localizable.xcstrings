    },
    "卸载重装本 App 后，本地写入记录会丢失，此前写入健康 App 的数据仍然有效，但无法再通过本 App 撤销。" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If you delete and reinstall this app, local write records will be lost. Data already written to the Health app remains valid, but can no longer be undone through this app."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "卸载重装本 App 后，本地写入记录会丢失，此前写入健康 App 的数据仍然有效，但无法再通过本 App 撤销。"
          }
        }
      }
    },
